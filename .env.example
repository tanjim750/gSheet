# All variables are OPTIONAL. This file contains application defaults, not secrets.
# GSheetConfig() reads process environment; it never loads .env automatically.
# To opt in, install gsheet[dotenv] and pass dotenv_path explicitly.
# Precedence: explicit section object > process environment > .env > defaults.
# Explicit sections replace the WHOLE corresponding environment section.
# Comma-separated lists; booleans must be exactly true or false.
# Empty values are invalid except retry categories (empty disables categories).
# Leave optional path/name values commented out rather than assigning blanks.
# Relative paths resolve against the process working directory, not this file.
# .env interpolation is disabled: use literal values, not ${OTHER_VARIABLE}.

# API access: read_only (default) or read_write.
GSHEET_API_ACCESS_MODE=read_only
# Optional comma-separated supported Google scopes. Omitted: derived from mode.
# Read-only mode rejects scopes that grant writes; write mode needs a write scope.
# Use raw URLs, never Markdown [label](url) links or JSON/list brackets.
# GSHEET_API_SCOPES=https://www.googleapis.com/auth/spreadsheets.readonly
# For read_write: GSHEET_API_SCOPES=https://www.googleapis.com/auth/spreadsheets
# Supported: spreadsheets, spreadsheets.readonly, drive, drive.readonly, drive.file
# All use the https://www.googleapis.com/auth/ prefix.
# Positive seconds; 30 is an application default, not Google's processing limit.
GSHEET_API_REQUEST_TIMEOUT_SECONDS=30
# Optional identification; omitted means no application identification.
# GSHEET_API_APPLICATION_NAME=my-application

# Authentication mode: none (default), service_account, or oauth.
# Credentials are not required to construct configuration, even in a chosen mode.
# validate_for_auth() checks file-based readiness before authentication.
# CredentialManager additionally requires an explicit connection_id argument;
# this is connection-local context, never a process-wide environment variable.
GSHEET_AUTH_MODE=none
# Optional existing credential file; requires service_account mode. Default: unset.
# GSHEET_AUTH_SERVICE_ACCOUNT_FILE=.credentials/service-account.json
# Optional existing client file; requires oauth mode. Default: unset.
# GSHEET_AUTH_OAUTH_CLIENT_FILE=.credentials/client_secret.json
# Optional token storage; requires oauth mode. Default: unset (no file storage).
# Existing file or new file in a private, existing directory. Config reads no files.
# Auth stores 0600 tokens bound to connection_id and client; foreign/unbound tokens
# are rejected. Use one token path per connection. No path means in-memory tokens.
# GSHEET_AUTH_OAUTH_TOKEN_FILE=.credentials/token.json
# Controls automatic AND explicit refresh; initialization never performs refresh.
GSHEET_AUTH_REFRESH_ENABLED=true
# Positive seconds before expiry at which auth refreshes on demand. Default: 60.
GSHEET_AUTH_REFRESH_MARGIN_SECONDS=60

# Total attempts INCLUDING the first; minimum 1 (no retries). Default: 3.
# Candidate retry policy only; never permits unsafe/uncertain write replay.
GSHEET_RETRY_MAX_ATTEMPTS=3
# Positive application-default delays in seconds; maximum must be >= initial.
GSHEET_RETRY_INITIAL_DELAY_SECONDS=1
GSHEET_RETRY_MAX_DELAY_SECONDS=32
# Must exceed 1; application default: 2.
GSHEET_RETRY_MULTIPLIER=2
# none, full, or additive. Default: full.
# Future semantics: full samples [0, capped delay]; additive adds up to 1s jitter
# before capping at max_delay_seconds; none uses the capped delay unchanged.
GSHEET_RETRY_JITTER=full
# Comma-separated distinct rate_limit, temporary_upstream, timeout; empty allowed.
# Timeout retries require operation-level safety checks. Default excludes timeout.
GSHEET_RETRY_RETRYABLE_CATEGORIES=rate_limit,temporary_upstream

# Metadata cache defaults to disabled; TTL/limits still validated when disabled.
GSHEET_CACHE_ENABLED=false
# Positive seconds; application default: 60. No external-edit freshness guarantee.
GSHEET_CACHE_TTL_SECONDS=60
# Bypass cached metadata even when enabled; default: false.
GSHEET_CACHE_FORCE_REFRESH=false
# Positive entry count; application default: 128, per future connection-local cache.
GSHEET_CACHE_MAX_ENTRIES=128

# DEBUG, INFO, WARNING (default), ERROR, CRITICAL. Client logging is per instance.
# Successful request records require INFO. Targets are hashed; no cell data logged.
GSHEET_OPERATIONS_LOGGING_LEVEL=WARNING
# Per-transport request-budget enforcement; default: true. Exhaustion fails fast
# with a retry delay. Each retry attempt reserves a slot. No distributed limiter.
GSHEET_OPERATIONS_THROTTLING_ENABLED=true
# Positive per-minute budgets. Google's published default quotas are 300/project
# and 60/user/project, separately for reads and writes. Projects can differ.
# These settings describe policy, do not change Google quotas, and do not enforce
# aggregate limits across processes. Service-account calls count as one account.
# https://developers.google.com/workspace/sheets/api/limits
GSHEET_OPERATIONS_READ_REQUESTS_PER_MINUTE_PER_PROJECT=300
GSHEET_OPERATIONS_WRITE_REQUESTS_PER_MINUTE_PER_PROJECT=300
GSHEET_OPERATIONS_READ_REQUESTS_PER_MINUTE_PER_USER=60
GSHEET_OPERATIONS_WRITE_REQUESTS_PER_MINUTE_PER_USER=60
# Positive application safety bounds, NOT official Google limits. Defaults: 100.
# Counts ranges in each values batch request, not bytes, cells, or structural edits.
GSHEET_OPERATIONS_MAX_READ_BATCH_RANGES=100
GSHEET_OPERATIONS_MAX_WRITE_BATCH_RANGES=100
# Positive application read bound in cells. Default: 100000; not a Google limit.
GSHEET_OPERATIONS_MAX_READ_CELLS=100000

# No raw credentials/tokens are supported as environment values. Keep files in
# .credentials/ (gitignored) or outside this repo; arbitrary filenames elsewhere
# are not automatically protected by .gitignore. Never commit credential files.
# OAuth scopes are not a per-business spreadsheet or operation allowlist.
